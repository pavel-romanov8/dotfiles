{
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "allow",
      "rm": "ask",
      "rm *": "ask",
      "rmdir": "ask",
      "rmdir *": "ask",
      "unlink": "ask",
      "unlink *": "ask",
      "truncate": "ask",
      "truncate *": "ask",
      "git clean*": "ask",
      "git reset --hard*": "ask",
      "git restore*": "ask",
      "git checkout --*": "ask",
      "git push*": "ask",
      "sudo": "deny",
      "sudo *": "deny"
    },
    "GitHub/*": "ask",
    "GitHub/get_me": "allow",
    "playwright/*": "ask"
  }
}
